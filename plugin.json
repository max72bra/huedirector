{
    "$schema": "https://duxlabs.dev/schemas/plugin.json",
    "id": "hueDirector",
    "name": "Hue Director",
    "description": "Control Philips Hue lights, rooms and scenes from the Dux Shell bar, with automations on login, lock, monitor power, sleep, logout, reboot and power off. Talks directly to the Hue Bridge (API v2).",
    "version": "1.2.1",
    "author": "maxb",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget"
    ],
    "components": {
        "daemon": "./HueEvents.qml",
        "widget": "./HueDirector.qml"
    },
    "settings": "./HueDirectorSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "icon": "lightbulb",
    "dependencies": [
        "curl",
        "openssl"
    ],
    "requires_dms": ">=2.0.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
