{
    "$schema": "https://duxlabs.dev/schemas/plugin.json",
    "id": "hueDirector",
    "name": "Hue Director",
    "description": "A Dux Shell Philips Hue manager interface",
    "version": "1.0.0",
    "author": "maxb",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget"
    ],
    "components": {
        "daemon": "./HueEvents.qml",
        "widget": "./HueDirector.qml"
    },
    "settings": "./HueDirectorSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "icon": "lightbulb",
    "dependencies": [
        "curl",
        "openssl"
    ],
    "requires_dms": ">=2.0.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
